# 复制为 .env 后填写（勿提交）
# copy:  copy .env.example .env

# 可选覆盖 URL；一般留空，使用 exams/<id>.json 里的 url
# EXAM_URL=

STORAGE_STATE_PATH=storage/pku_exam_state.json
HEADLESS=false
AUTO_SUBMIT=false

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# rag | full | direct（无 refs 的场次会自动用 direct）
DEEPSEEK_MODE=rag
DEEPSEEK_RAG_TOP_K=4
# 模型返回 need_more 时扩检一次：更大 top_k + 多路 RRF + 关 early-stop
DEEPSEEK_RAG_RETRY=true
DEEPSEEK_RAG_RETRY_TOP_K=8
DEEPSEEK_KEEP_HISTORY=false

# 答题调试日志（也可用 --debug）：写入 debug/<exam>_<时间戳>/
DEBUG=false
