# 复制为 .env 后填写（勿提交）
# copy:  copy .env.example .env

PKU_USERNAME=
PKU_PASSWORD=

# 场次 id（exams/<id>/）；也可用 --exam
EXAM_ID=exam54

# 可选覆盖 URL；一般留空，使用 exams/<id>/exam.json
# EXAM_URL=

STORAGE_STATE_PATH=storage/pku_exam_state.json
HEADLESS=false
AUTO_SUBMIT=false

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# rag | full | direct（无 refs 的场次会自动用 direct）
DEEPSEEK_MODE=rag
DEEPSEEK_RAG_TOP_K=4
DEEPSEEK_KEEP_HISTORY=false
